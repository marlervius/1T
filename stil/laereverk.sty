% ---------- Læreverksinnstillinger (settes i stil/oppsett.tex) ----------
\newcommand{\fagnavn}{Matematikk 1T}
\newif\ifmittsprak \mittspraktrue
\newcommand{\settfag}[1]{\renewcommand{\fagnavn}{#1}}

% ---------- Metadata for seksjonen (settes i meta.tex) ----------
\newcommand{\snr}{0.0}
\newcommand{\stittel}{Uten tittel}
\newcommand{\sundertittel}{}
\newcommand{\smaal}{}
\newcommand{\skompetanse}{}
\newcommand{\shvakanjeg}{}
\newcommand{\seksjon}[2]{\renewcommand{\snr}{#1}\renewcommand{\stittel}{#2}}
\newcommand{\undertittel}[1]{\renewcommand{\sundertittel}{#1}}
\newcommand{\maal}[1]{\renewcommand{\smaal}{#1}}
\newcommand{\kompetansemaal}[1]{\renewcommand{\skompetanse}{#1}}
% Målteksten defineres av bygg.py (fra laereplan/kompetansemaal-1T.md): \kmdef{6}{tekst}
\makeatletter
\newcommand{\kmdef}[2]{\expandafter\def\csname km@#1\endcsname{#2}}
\newcommand{\kmtekst}[1]{\ifcsname km@#1\endcsname\csname km@#1\endcsname\else\textbf{(ukjent mål KM#1)}\fi}
\makeatother
\newcommand{\hvakanjeg}[1]{\renewcommand{\shvakanjeg}{#1}}
% Rad i «Hva kan jeg?»:  \kan{del}{jeg kan ...}   (\kanskille gir luft mellom deler)
\newcommand{\kan}[2]{#1 & #2 & \boks & \boks & \boks\\}
\newcommand{\kanskille}{\addlinespace[3pt]}

% ---------- Dokumenttype (settes av byggeskriptet) ----------
% 1 = teori og oppgaver, 2 = ekstra utfordring, 3 = fasit
\newcommand{\dokumenttype}{1}
\newcommand{\doknavn}{\ifcase\dokumenttype\or Teori og oppgaver\or Ekstra utfordring\or Fasit\fi}

% ---------- Topptekst ----------
\pagestyle{fancy}
\fancyhf{}
\lhead{\small\color{graa} \fagnavn\ · \snr\ \stittel}
\rhead{\small\color{graa} \doknavn}
\cfoot{\small\color{graa} Side \thepage\ av \pageref{LastPage}}
\renewcommand{\headrulewidth}{0.4pt}

% ---------- tasks ----------
\settasks{label=\alph*), label-width=1.4em, item-indent=1.8em, column-sep=1.5em,
  after-item-skip=3pt, item-format=\raggedright}

% ---------- Nivå ----------
\newcommand{\prikk}[1]{\tikz[baseline=-0.6ex]\fill[#1] (0,0) circle (0.9ex);}
\newcommand{\tomprikk}[1]{\tikz[baseline=-0.6ex]\draw[#1,line width=0.6pt] (0,0) circle (0.8ex);}
\newcommand{\nivfarge}[1]{\ifcase#1\or niv1\or niv2\or niv3\fi}
\newcommand{\nivprikker}[1]{%
  \ifcase#1\or
    {\prikk{niv1}\,\tomprikk{niv1}\,\tomprikk{niv1}}%
  \or
    {\prikk{niv2}\,\prikk{niv2}\,\tomprikk{niv2}}%
  \or
    {\prikk{niv3}\,\prikk{niv3}\,\prikk{niv3}}%
  \fi}
% Nivånavn: hovedheftet og utfordringsarket har ulike navn
\newcommand{\nivnavn}[1]{%
  \ifnum\dokumenttype=2
    \ifcase#1\or Kom i gang\or Fordypning\or Ekstra utfordring\fi
  \else
    \ifcase#1\or Grunnleggende\or Middels\or Utfordring\fi
  \fi}

% ---------- Hjelpemidler (1T-eksamen: Del 1 / Del 2) ----------
\newcommand{\merke}[2]{\tcbox[on line,boxsep=1pt,left=3pt,right=3pt,top=1pt,bottom=1pt,
  colback=#1,colframe=graa,boxrule=0.6pt,arc=2pt]{\scriptsize\bfseries #2}}
\newcommand{\uh}{\merke{white}{UTEN HJELPEMIDLER}}
\newcommand{\mh}{\merke{graa!15}{MED HJELPEMIDLER}}
\newcommand{\prog}{\merke{hovedlys}{PROGRAMMERING}}
% Bakoverkompatible navn fra matte-hefte
\let\uk\uh
\let\mk\mh

% ---------- Oppgavehode: \oppg{nummer}{nivå 1-3}{\uh | \mh | \prog} ----------
\newcounter{gjeldendeniva}
\newcommand{\oppg}[3]{%
  \par\addvspace{7pt}\needspace{6\baselineskip}\noindent
  \tcbox[on line,boxsep=1pt,left=4pt,right=4pt,top=2pt,bottom=2pt,
    colback=\nivfarge{#2},colframe=\nivfarge{#2},arc=2pt]{\color{white}\bfseries Oppgave #1}%
  \hspace{0.6em}\nivprikker{#2}\hfill#3\par\nopagebreak\vspace{2pt}}

% ---------- Nivåoverskrift: \nivaahode{1|2|3} ----------
\newcommand{\nivaahode}[1]{%
  \par\addvspace{10pt}\needspace{9\baselineskip}\noindent
  {\color{\nivfarge{#1}}\rule[0.5ex]{1.2em}{1.2pt}\ \textbf{\large Nivå #1 · \nivnavn{#1}}\ \leaders\hrule height 0.6ex depth -0.5ex\hfill\null}\par\vspace{2pt}}

% ---------- Delhode: \del{nr}{tittel} — starter ny side ----------
\makeatletter
\newcommand{\delliste}{}
\newcommand{\leggtildel}[2]{\g@addto@macro\delliste{\delrad{#1}{#2}}}
\newcommand{\delrad}[2]{#1 & #2 & \pageref{del#1}\\}
\newcommand{\del}[2]{%
  \clearpage
  \phantomsection\label{del#1}%
  \protected@write\@auxout{}{\string\leggtildel{#1}{#2}}%
  \begin{tcolorbox}[colback=hoved,colframe=hoved,arc=3pt,left=8pt,right=8pt,top=6pt,bottom=6pt]
    \color{white}{\Large\bfseries #1\quad #2}\hfill{\small\doknavn}
  \end{tcolorbox}\vspace{2pt}}
% Utfordringsarket og deler som ikke skal starte på ny side:
\newcommand{\delhode}[2]{%
  \par\addvspace{6pt}\needspace{8\baselineskip}%
  \begin{tcolorbox}[colback=hoved,colframe=hoved,arc=3pt,left=8pt,right=8pt,top=6pt,bottom=6pt]
    \color{white}{\Large\bfseries #1\quad #2}\hfill{\small\doknavn}
  \end{tcolorbox}\vspace{2pt}}
\makeatother

% ---------- Bokser ----------
\newtcolorbox{mustkunne}{colback=hovedlys,colframe=hoved,arc=3pt,boxrule=0.8pt,
  title={\bfseries Dette må du kunne},fonttitle=\normalsize,left=6pt,right=6pt,breakable}
\newtcolorbox{eksempel}[1][]{colback=eksbg,colframe=eksramme,arc=3pt,boxrule=0.8pt,
  title={\bfseries Eksempel #1},coltitle=black,fonttitle=\normalsize,left=6pt,right=6pt}
\newtcolorbox{vanligfeil}{colback=feilbg,colframe=niv3,arc=3pt,boxrule=0.8pt,
  title={\bfseries Vanlig feil på prøver},fonttitle=\normalsize,left=6pt,right=6pt}
\newtcolorbox{sjekk}{colback=white,colframe=hoved,arc=3pt,boxrule=1pt,
  title={\bfseries Sjekk deg selv — prøv uten hjelp},fonttitle=\normalsize,left=6pt,right=6pt}
% Fri infoboks: \begin{infoboks}{Tittel} ... \end{infoboks}
\newtcolorbox{infoboks}[1]{colback=white,colframe=hoved,arc=3pt,boxrule=1pt,
  title={\bfseries #1},fonttitle=\normalsize,left=6pt,right=6pt}
% Oppsummering (gul, uten «Eksempel»)
\newtcolorbox{oppsummering}{colback=eksbg,colframe=eksramme,arc=3pt,boxrule=0.8pt,
  title={\bfseries Kort oppsummering},coltitle=black,fonttitle=\normalsize,left=6pt,right=6pt}

% ---------- Ord du trenger:  ord & forklaring & \mittsprak\\ ----------
% Når «Mitt språk» er slått av, blir tredje kolonne usynlig (0 bredde).
\newcommand{\mittsprakstrek}{\rule[-2pt]{3.4cm}{0.4pt}}
\newcommand{\mittsprak}{\ifmittsprak\mittsprakstrek\fi}
\newenvironment{ordliste}{%
  \begin{tcolorbox}[colback=ordbg,colframe=ordramme,arc=3pt,boxrule=0.8pt,
    title={\bfseries Ord du trenger},fonttitle=\normalsize,left=4pt,right=4pt,top=2pt,bottom=2pt]
  \small\renewcommand{\arraystretch}{1.3}%
  \ifmittsprak
  \begin{tabular}{@{}>{\bfseries\raggedright\arraybackslash}p{3.3cm} >{\raggedright\arraybackslash}p{\dimexpr\linewidth-6.9cm-4\tabcolsep\relax} p{3.6cm}@{}}
  \textcolor{ordramme}{Norsk} & \textcolor{ordramme}{\textbf{Forklaring}} & \textcolor{ordramme}{\textbf{Mitt språk}}\\\hline
  \else
  \begin{tabular}{@{}>{\bfseries\raggedright\arraybackslash}p{3.3cm} >{\raggedright\arraybackslash}p{\dimexpr\linewidth-3.3cm-2\tabcolsep\relax} @{}l@{}}
  \textcolor{ordramme}{Begrep} & \textcolor{ordramme}{\textbf{Forklaring}} & \\\hline
  \fi}
  {\end{tabular}\end{tcolorbox}}

% ---------- Steg-tabell i eksempler:  utregning & forklaring\\ ----------
\newenvironment{stegtabell}{\renewcommand{\arraystretch}{1.25}%
  \begin{tabular}{@{}S{>{\raggedright\arraybackslash}p{0.45\linewidth}}>{\raggedright\arraybackslash\small\leavevmode\color{graa}}p{\dimexpr0.55\linewidth-2\tabcolsep\relax}@{}}}
  {\end{tabular}}

