% ---------- Små hjelpere ----------
\newcommand{\skrivlinje}[1][4cm]{\rule[-2pt]{#1}{0.4pt}}
\newcommand{\boks}{\tikz[baseline=0pt]\draw[line width=0.6pt] (0,-0.15ex) rectangle (1.6ex,1.45ex);}
\newcommand{\rute}{\tikz[baseline=-0.4ex]\draw[line width=0.6pt] (0,-0.5ex) rectangle (2.2em,1.9ex);}
\newcommand{\hint}[1]{\par{\small\color{graa}\textit{Tips: #1}}}
\newcommand{\VS}{\text{VS}}
\newcommand{\HS}{\text{HS}}

% ---------- Fasit ----------
\newcommand{\fk}[1]{\par\addvspace{6pt}{\color{hoved}\bfseries #1}\par\vspace{1pt}}
\newcommand{\fo}[1]{\par\textbf{#1}\ }
\newenvironment{fasitspalter}{\normalsize\setlength{\parskip}{3pt}\setlength{\columnsep}{2em}\begin{multicols}{2}\raggedright}{\end{multicols}}

% ---------- Forsider (brukes av byggeskriptet) ----------
\newcommand{\banner}[3]{% #1 overlinje, #2 tittel, #3 bakgrunnsfarge
  \begin{tcolorbox}[colback=#3,colframe=#3,arc=4pt,left=12pt,right=12pt,top=12pt,bottom=12pt]
    \raggedright\color{white}
    {\small\MakeUppercase{#1}}\\[5pt]
    {\fontsize{24}{28}\selectfont\bfseries #2}%
    \ifdefempty{\sundertittel}{}{\\[5pt]{\Large \sundertittel}}%
    \ifdefempty{\smaal}{}{\\[3pt]{\normalsize Mål: \smaal}}
  \end{tcolorbox}}

\newcommand{\navnlinje}{%
  \vspace{4pt}
  \textbf{Navn:} \skrivlinje[8cm]\hfill \textbf{Klasse:} \skrivlinje[3.5cm]\par\vspace{6pt}}

\newcommand{\nivaalegende}{%
  \begin{tabularx}{\linewidth}{@{}l X@{}}
  \nivprikker{1}\ {\color{niv1}\textbf{\nivnavn{1}}} & \ifnum\dokumenttype=2 Varm opp. Prøv metoden.\else Start her. Dette må alle kunne.\fi\\
  \nivprikker{2}\ {\color{niv2}\textbf{\nivnavn{2}}} & \ifnum\dokumenttype=2 Kombiner flere steg. Velg framgangsmåte.\else Vanlige prøveoppgaver.\fi\\
  \nivprikker{3}\ {\color{niv3}\textbf{\nivnavn{3}}} & \ifnum\dokumenttype=2 Undersøk, lag selv og begrunn.\else For deg som vil ha mer. Krever forklaring.\fi\\[3pt]
  \uh & Del 1 på eksamen: uten kalkulator og digitale verktøy.\\
  \mh & Del 2 på eksamen: kalkulator, GeoGebra eller Python.\\
  \end{tabularx}}

\newcommand{\hvakanjegtabell}{%
  \ifdefempty{\shvakanjeg}{}{%
  \section*{\color{hoved}Hva kan jeg?}
  Sett kryss før du begynner og når du er ferdig.\par
  {\small
  \begin{tabularx}{\linewidth}{@{}c X *{3}{>{\centering\arraybackslash}p{1.2cm}}@{}}
  \toprule
  \textbf{Del} & \textbf{Jeg kan \dots} & \textbf{Ja} & \textbf{Nesten} & \textbf{Ikke ennå}\\
  \midrule
  \shvakanjeg
  \bottomrule
  \end{tabularx}}}}

\newcommand{\innhold}{%
  \ifdefempty{\delliste}{}{%
  \begin{tabularx}{\linewidth}{@{}c X r@{}}
  \toprule
  \textbf{Del} & \textbf{Tema} & \textbf{Side}\\
  \midrule
  \delliste
  \bottomrule
  \end{tabularx}}}

\newcommand{\kompetansefot}{%
  \ifdefempty{\skompetanse}{}{\par\vfill{\footnotesize\color{graa}\textbf{Seksjonen bygger mot disse kompetansemålene etter 1T} (LK20, MAT09-02).
    Eleven skal kunne\par
    \begin{itemize}[leftmargin=1.2em,itemsep=0pt,topsep=1pt,parsep=0pt]
    \foreach \km in \skompetanse {\item \kmtekst{\km}}
    \end{itemize}\par}}}

% Forside for «Teori og oppgaver»
\newcommand{\forsideteori}{%
  \thispagestyle{empty}
  \banner{\fagnavn\ · Teori og oppgaver}{\snr\quad\stittel}{hoved}
  \navnlinje
  \innhold
  \vspace{2pt}
  \hvakanjegtabell
  \vspace{6pt}
  \nivaalegende
  \kompetansefot}

% Forside for «Ekstra utfordring» (ingen egen forside — arket starter direkte)
\newcommand{\forsideutfordring}{%
  \thispagestyle{empty}
  \banner{\fagnavn\ · Ekstra utfordring}{\snr\quad\stittel\ — utfordring}{hoved}
  \navnlinje
  \nivaalegende\par\vspace{4pt}}

% Forside for fasit
\newcommand{\forsidefasit}{%
  \thispagestyle{empty}
  \begin{tcolorbox}[colback=graa,colframe=graa,arc=3pt,left=8pt,right=8pt,top=6pt,bottom=6pt]
    \color{white}{\Large\bfseries Fasit — \snr\ \stittel}\\[2pt]{\small Kontroller metoden, ikke bare svaret.}
  \end{tcolorbox}}

